{
    "name": "coffeecutie",
    "license": "MIT",
    "version-string": "4.0",
    "dependencies": [
        { "name": "boost-stacktrace", "platform": "osx | ios" },
        { "name": "boost-stacktrace", "platform": "android", "default-features": false },
        { "name": "cppcodec", "platform": "!bare" },
        "cxxopts",
        "fmt",
        "glm",
        { "name": "hash-library", "platform": "!bare" },
        "magic-enum",
        "ms-gsl",
        "nlohmann-json",
        "stb",
        "utfcpp",
        { "name": "zlib-ng", "platform": "(linux & x64) | osx | windows" },
        { "name": "zstd", "platform": "!bare" }
    ],
    "features": {
        "assimp": {
            "description": "Model processing",
            "dependencies": [
                { "name": "assimp", "platform": "(linux & x64) | osx | windows" }
            ]
        },
        "audio": {
            "description": "Audio output support",
            "dependencies": [
                { "name": "openal-soft", "platform": "linux | osx | windows | android" },
                { "name": "libvorbis" }
            ]
        },
        "benchmarks": {
            "description": "Micro benchmark tools",
            "dependencies": [
                "nanobench"
            ]
        },
        "blam": {
            "description": "Blam! data support",
            "dependencies": [
                { "name": "libwma", "platform": "linux | osx | windows | android" }
            ]
        },
        "cursed": {
            "description": "Cursed data support",
            "dependencies": [
                { "name": "bzip2", "platform": "!bare" }
            ]
        },
        "crash-recovery": { "description": "Crash reporting and logging tool"},
        "devkit": {
            "description": "Devkit support for Gamecube/Wii",
            "dependencies": [
                { "name": "gctools", "platform": "gamecube | wii", "host": true },
                { "name": "libogc", "platform": "gamecube | wii" },
                { "name": "libfat", "platform": "gamecube | wii" }
            ]
        },
        "headful": { 
            "description": "Graphical support",
            "dependencies": [
                { "name": "squashfuse", "platform": "linux & (x64 | arm64)" },
                { "name": "discord-rpc", "platform": "(linux & x64) | osx | (windows & !mingw)" },
                { "name": "pvrscope", "platform": "linux & arm & beaglebone" },
                { "name": "nvidia-gdk", "platform": "linux & x64" },
                { "name": "nativefiledialog-extended", "platform": "!linux & (x11 | wayland)" }
            ]
        },
        "gleam": {
            "description": "Desktop OpenGL + Mobile OpenGL ES rendering library",
            "dependencies": [
                { "name": "angle", "platform": "windows & uwp" },
                "bcdec",
                { "name": "imgui", "features": ["docking-experimental"]},
                { "name": "ktx", "features": ["vulkan"], "platform": "!bare" },
                { "name": "pvrtcdec", "platform": "linux & x64" },
                "vulkan-headers"
            ]
        },
        "media": {
            "description": "Media encoding",
            "dependencies": [
                { "name": "ffmpeg", "platform": "(linux & x64) | (windows & !mingw)" }
            ]
        },
        "network": {
            "description": "Networking support",
            "dependencies": [
                { "name": "curl", "features": ["openssl","ssl"], "default-features": false, "platform": "!emscripten" },
                { "name": "gamenetworkingsockets", "platform": "!emscripten & !(android & arm32)" },
                { "name": "gamenetworkingsockets", "features": ["webrtc-datachannel"], "platform": "!emscripten & !android" },
                { "name": "gamenetworkingsockets", "features": ["webrtc-datachannel"], "platform": "emscripten" }
            ]
        },
        "openssl": {
            "description": "OpenSSL support in ASIO + some crypto functionality",
            "dependencies": [
                "openssl"
            ]
        },
        "physics": {
            "description": "Physics support",
            "dependencies": [
                "bullet3"
            ]
        },
        "pressure-cooker": {
            "description": "Asset packing utilities",
            "dependencies": [
                { "name": "bc7enc", "platform": "(linux & (x64 | arm64)) | osx | windows" },
                "bcdec",
                { "name": "etc2comp", "platform": "(linux & (x64 | arm64)) | osx | windows" },
                { "name": "glslang", "platform": "(linux & (x64 | arm64)) | osx | windows", "features": ["tools"] },
                { "name": "ktx", "platform": "(linux & (x64 | arm64)) | osx | windows", "features": ["basisu", "vulkan", "write"] },
                { "name": "libsquish", "platform": "(linux & x64) | osx | windows" },
                "pvrtc",
                { "name": "shaderc", "platform": "(linux & (x64 | arm64)) | osx | windows" },
                { "name": "spirv-cross", "platform": "(linux & (x64 | arm64)) | osx | windows" },
                "vulkan-headers"
            ]
        },
        "sdl3": { 
            "description": "SDL3 support",
            "dependencies": [
                {
                    "name": "sdl3",
                    "platform": "linux & x64",
                    "default-features": false,
                    "features": ["wayland", "x11"]
                },
                {
                    "name": "sdl3",
                    "platform": "linux & arm & wayland & !x11",
                    "default-features": false,
                    "features": ["wayland"]
                },
                {
                    "name": "sdl3",
                    "platform": "linux & arm & wayland & x11",
                    "default-features": false,
                    "features": ["wayland", "x11"]
                },
                {
                    "name": "sdl3",
                    "platform": "linux & arm & raspberry",
                    "default-features": false,
                    "features": []
                },
                { "name": "sdl3", "platform": "osx | windows | mingw"}
            ]
        },
        "tests": {
            "description": "Unit tests",
            "dependencies": [
                "doctest"
            ]
        }
    },
    "default-features": [
        "image",
        "openssl",
        "physics"
    ],
    "overrides": [
        {
            "name": "libogg",
            "version": "1.3.6",
            "port-version": 1
        }
    ]
}
