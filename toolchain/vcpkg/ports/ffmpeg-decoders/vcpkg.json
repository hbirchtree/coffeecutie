{
  "name": "ffmpeg-decoders",
  "version": "8.1.2",
  "description": "libavcodec + libavutil reduced to chosen audio decoders, as one shared library (a side module on Emscripten) so the LGPL code stays replaceable",
  "homepage": "https://ffmpeg.org",
  "license": "LGPL-2.1-or-later",
  "supports": "linux | osx | emscripten",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "vcpkg-cmake-get-vars",
      "host": true
    }
  ],
  "features": {
    "xma": {
      "description": "XMA1/XMA2 (Xbox 360)"
    },
    "wma": {
      "description": "WMA v1/v2"
    },
    "wmapro": {
      "description": "WMA Pro"
    },
    "vorbis": {
      "description": "Vorbis (native decoder)"
    },
    "opus": {
      "description": "Opus (native decoder)"
    },
    "mp3": {
      "description": "MPEG audio layer 3"
    },
    "flac": {
      "description": "FLAC"
    },
    "adpcm": {
      "description": "IMA and Microsoft ADPCM"
    }
  }
}
