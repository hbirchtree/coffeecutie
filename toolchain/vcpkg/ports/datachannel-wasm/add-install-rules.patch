diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -25,11 +25,58 @@
 	CXX_STANDARD 17)
 
 target_include_directories(datachannel-wasm PUBLIC
-	${CMAKE_CURRENT_SOURCE_DIR}/wasm/include)
+	$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/wasm/include>
+	$<INSTALL_INTERFACE:include>)
 target_include_directories(datachannel-wasm PRIVATE
 	${CMAKE_CURRENT_SOURCE_DIR}/wasm/include/rtc)
 
+# No longer adding -pthread here (this package's own object files need
+# atomics/shared-memory support to link into coffeecutie's always-
+# --shared-memory Emscripten binary -- see
+# examples/blam/cblam-testing/WEBRTC_TRANSPORT.md's Phase 3 threading
+# note; found by actually attempting the link: "wasm-ld: error:
+# --shared-memory is disallowed by peerconnection.cpp.o because it was
+# not compiled with 'atomics' or 'bulk-memory' features"). The
+# coffeecutie wasm32-emscripten triplet now sets VCPKG_C_FLAGS/
+# VCPKG_CXX_FLAGS to -pthread project-wide
+# (toolchain/vcpkg/triplets/wasm32-emscripten.cmake, consumed by
+# toolchain/cmake/Platform/Emscripten.cmake), so every port -- this one
+# included -- already gets it without a per-port patch.
+
+# Added for coffeecutie's vcpkg overlay port: upstream has no install()
+# rules at all (this project is normally consumed by copying the wasm/
+# directory straight into another CMake project, not via find_package).
+# The --js-library options need to reference the *installed* location of
+# webrtc.js/websocket.js, not the build tree (which vcpkg deletes after
+# building) -- $<INSTALL_PREFIX> is exactly the generator expression this
+# situation exists for: it resolves relative to wherever the exported
+# target ends up being find_package()'d from, not baked in at configure
+# time.
 target_link_options(datachannel-wasm PUBLIC
-	"SHELL:--js-library \"${CMAKE_CURRENT_SOURCE_DIR}/wasm/js/webrtc.js\""
-	"SHELL:--js-library \"${CMAKE_CURRENT_SOURCE_DIR}/wasm/js/websocket.js\"")
+	"$<BUILD_INTERFACE:SHELL:--js-library \"${CMAKE_CURRENT_SOURCE_DIR}/wasm/js/webrtc.js\">"
+	"$<BUILD_INTERFACE:SHELL:--js-library \"${CMAKE_CURRENT_SOURCE_DIR}/wasm/js/websocket.js\">"
+	"$<INSTALL_INTERFACE:SHELL:--js-library \"$<INSTALL_PREFIX>/share/datachannel-wasm/webrtc.js\">"
+	"$<INSTALL_INTERFACE:SHELL:--js-library \"$<INSTALL_PREFIX>/share/datachannel-wasm/websocket.js\">")
+
+install(TARGETS datachannel-wasm
+	EXPORT datachannel-wasm-targets
+	ARCHIVE DESTINATION lib
+)
+install(DIRECTORY wasm/include/ DESTINATION include)
+install(FILES wasm/js/webrtc.js wasm/js/websocket.js DESTINATION share/datachannel-wasm)
+install(EXPORT datachannel-wasm-targets
+	FILE datachannel-wasm-targets.cmake
+	NAMESPACE datachannel-wasm::
+	DESTINATION share/datachannel-wasm
+)
+
+include(CMakePackageConfigHelpers)
+configure_package_config_file(
+	"${CMAKE_CURRENT_SOURCE_DIR}/datachannel-wasm-config.cmake.in"
+	"${CMAKE_CURRENT_BINARY_DIR}/datachannel-wasm-config.cmake"
+	INSTALL_DESTINATION share/datachannel-wasm
+)
+install(FILES "${CMAKE_CURRENT_BINARY_DIR}/datachannel-wasm-config.cmake"
+	DESTINATION share/datachannel-wasm
+)
 
