+    // delaying them a few seconds is harmless, wedging the thread is not.
+    const SteamNetworkingMicroseconds usecNowThrottle = SteamNetworkingSockets_GetLocalTimestamp();
+    if ( usecNowThrottle < m_usecNextReflexiveRetry )
+        return;
+    m_usecNextReflexiveRetry = usecNowThrottle + 5*k_nMillion;
