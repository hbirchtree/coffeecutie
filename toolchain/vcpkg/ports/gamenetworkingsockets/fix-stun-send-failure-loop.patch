         bool m_bInterfaceListStale;
+        // Earliest time we may re-issue a server-reflexive bind request;
+        // see the throttles in the reflexive STUN callbacks.
+        SteamNetworkingMicroseconds m_usecNextReflexiveRetry = 0;
         int m_nEncoding;
         std::string m_strLocalUsernameFragment;
         std::string m_strLocalPassword;
