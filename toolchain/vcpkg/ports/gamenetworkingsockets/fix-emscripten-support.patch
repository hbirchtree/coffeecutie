@@ -161,6 +161,13 @@
 #elif defined( __ANDROID__ ) || defined( ANDROID )
 	#define IsAndroid() true
 	#define IsPosix() true
+#elif defined( __EMSCRIPTEN__ )
+	// Deliberately its own identity, not aliased to IsLinux(): Emscripten's
+	// libc emulates enough POSIX for GNS's socket/threading code, but has
+	// no epoll, no /proc, no ptrace -- code gated on IsLinux() assumes
+	// real kernel facilities that don't exist here.
+	#define IsEmscripten() true
+	#define IsPosix() true
 #elif defined(__APPLE__)
 	#include <TargetConditionals.h>
 	// https://stackoverflow.com/questions/12132933/preprocessor-macro-for-os-x-targets
@@ -200,6 +207,9 @@
