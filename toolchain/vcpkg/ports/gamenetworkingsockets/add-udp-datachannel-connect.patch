+// Added for coffeecutie -- see the declaration comment in
+// steamnetworkingsockets_udp.h. Mirrors BInitConnect above, except the
+// bound socket comes from the caller's factory instead of
+// OpenUDPSocketBoundToHost, so the ordinary UDP protocol can run over a
+// transport GNS knows nothing about (a WebRTC DataChannel).
+bool CSteamNetworkConnectionUDP::BInitConnectBoundSocket( FnCreateBoundSocket fnCreateSocket, void *pContext, int nOptions, const SteamNetworkingConfigValue_t *pOptions, SteamDatagramErrMsg &errMsg )
+{
+	AssertMsg( !m_pTransport, "Trying to connect when we already have a socket?" );
+
+	// We're initiating a connection, not being accepted on a listen socket
+	Assert( !m_pParentListenSocket );
+	Assert( !m_bConnectionInitiatedRemotely );
+
+	Assert( m_identityRemote.IsInvalid() );
+	m_identityRemote.Clear();
+
+	// The remote address is a placeholder for this transport (the far end is
+	// wherever the DataChannel goes), so authenticate as if it were local:
+	// the anti-spoofing that matters here is connection-ID based.
+	if ( !BSetLocalIdentityAndCheckForAuthOverride( true, nOptions, pOptions, errMsg ) )
+		return false;
+
+	CConnectionTransportUDP *pTransport = new CConnectionTransportUDP( *this );
+	IBoundUDPSocket *pSocket = (*fnCreateSocket)( pTransport->RecvCallback(), pContext );
+	if ( pSocket == nullptr )
+	{
+		V_strcpy_safe( errMsg, "Caller failed to create a bound socket" );
+		pTransport->TransportDestroySelfNow();
+		return false;
+	}
+	pTransport->m_pSocket = pSocket;
+	m_pTransport = pTransport;
+
+	// Let base class do some common initialization
+	SteamNetworkingMicroseconds usecNow = SteamNetworkingSockets_GetLocalTimestamp();
+	if ( !CSteamNetworkConnectionBase::BInitConnection( usecNow, nOptions, pOptions, errMsg ) )
+	{
+		DestroyTransport();
+		return false;
+	}
+
+	// Start the connection state machine
+	return BConnectionState_Connecting( usecNow, errMsg );
+}
