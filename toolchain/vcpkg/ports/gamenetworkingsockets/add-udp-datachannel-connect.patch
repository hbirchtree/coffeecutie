+// Added for coffeecutie -- see the declaration comment in
+// isteamnetworkingsockets.h. Same always-defined/feature-gated-body shape
+// as AcceptP2PWebRTCDataChannel above.
+HSteamNetConnection CSteamNetworkingSockets::ConnectUDPWebRTCDataChannel(
+	const SteamNetworkingIPAddr &addressRemote,
+	std::shared_ptr<rtc::PeerConnection> pPeerConnection,
+	std::shared_ptr<rtc::DataChannel> pDataChannel,
+	int nOptions, const SteamNetworkingConfigValue_t *pOptions )
+{
+#ifdef STEAMNETWORKINGSOCKETS_ENABLE_WEBRTC_DATACHANNEL
+	SteamNetworkingGlobalLock scopeLock( "ConnectUDPWebRTCDataChannel" );
+	return ConnectUDPWebRTCDataChannelInternal( this, addressRemote, std::move( pPeerConnection ), std::move( pDataChannel ), nOptions, pOptions );
+#else
+	(void)addressRemote; (void)pPeerConnection; (void)pDataChannel; (void)nOptions; (void)pOptions;
+	SpewError( "ConnectUDPWebRTCDataChannel: not compiled in this build (gamenetworkingsockets built without the webrtc-datachannel feature)" );
+	return k_HSteamNetConnection_Invalid;
+#endif
+}
