+#ifdef STEAMNETWORKINGSOCKETS_ENABLE_WEBRTC_DATACHANNEL
+HSteamNetConnection CSteamNetworkingSockets::ConnectP2PWebRTCDataChannel(
+	ISteamNetworkingConnectionSignaling *pSignaling,
+	const SteamNetworkingIdentity *pPeerIdentity,
+	int nRemoteVirtualPort,
+	std::shared_ptr<rtc::PeerConnection> pPeerConnection,
+	std::shared_ptr<rtc::DataChannel> pDataChannel,
+	int nOptions, const SteamNetworkingConfigValue_t *pOptions
+)
+{
+	if ( !pSignaling || !pDataChannel )
+		return k_HSteamNetConnection_Invalid;
+
+	SteamNetworkingGlobalLock scopeLock( "ConnectP2PWebRTCDataChannel" );
+	ConnectionScopeLock connectionLock;
+
+	// Mirrors InternalConnectP2P's shape (construct, then BInitConnect),
+	// with the transport attached in between -- see the declaration
+	// comment in csteamnetworkingsockets.h for why this can't just reuse
+	// InternalConnectP2P/ConnectP2PCustomSignaling directly, and for the
+	// v1 simplification (no symmetric-connect matching) this implies.
+	CSteamNetworkConnectionP2P *pConn = new CSteamNetworkConnectionP2P( this, connectionLock );
+	if ( !pConn )
+	{
+		pSignaling->Release();
+		return k_HSteamNetConnection_Invalid;
+	}
+
+	pConn->AttachWebRTCDataChannelTransport( std::move( pPeerConnection ), std::move( pDataChannel ) );
+
+	SteamDatagramErrMsg errMsg;
+	CSteamNetworkConnectionP2P *pMatchingConnection = nullptr;
+	if ( pConn->BInitConnect( pSignaling, pPeerIdentity, nRemoteVirtualPort, nOptions, pOptions, &pMatchingConnection, errMsg ) )
+		return pConn->m_hConnectionSelf;
+
+	SpewError( "Cannot create P2P WebRTC DataChannel connection.  %s", errMsg );
+	pConn->ConnectionQueueDestroy();
+	return k_HSteamNetConnection_Invalid;
+}
+#endif
