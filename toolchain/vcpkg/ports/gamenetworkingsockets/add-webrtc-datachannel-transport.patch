+// Added for coffeecutie -- see the declaration comment in
+// isteamnetworkingsockets.h. Always defined (same reasoning as
+// ConnectP2PWebRTCDataChannel in steamnetworkingsockets_p2p.cpp: the
+// interface declaration is unconditional, so the vtable must be too);
+// only the body is feature-gated.
+bool CSteamNetworkingSockets::AcceptP2PWebRTCDataChannel(
+	HSteamNetConnection hConn,
+	std::shared_ptr<rtc::PeerConnection> pPeerConnection,
+	std::shared_ptr<rtc::DataChannel> pDataChannel )
+{
+#ifdef STEAMNETWORKINGSOCKETS_ENABLE_WEBRTC_DATACHANNEL
+	CConnectionTransportP2PWebRTC *pTransport = nullptr;
+	{
+		SteamNetworkingGlobalLock scopeLock( "AcceptP2PWebRTCDataChannel" );
+		ConnectionScopeLock connectionLock;
+		CSteamNetworkConnectionBase *pConnBase = GetConnectionByHandleForAPI( hConn, connectionLock, nullptr );
+		if ( !pConnBase )
+		{
+			SpewError( "AcceptP2PWebRTCDataChannel: invalid connection handle #%u", hConn );
+			return false;
+		}
+		CSteamNetworkConnectionP2P *pConn = pConnBase->AsSteamNetworkConnectionP2P();
+		if ( !pConn )
+		{
+			SpewError( "AcceptP2PWebRTCDataChannel: connection #%u is not a P2P connection", hConn );
+			return false;
+		}
+		pTransport = pConn->AttachWebRTCDataChannelTransport( std::move( pPeerConnection ), std::move( pDataChannel ) );
+	}
+	// Deliberately outside the lock: installing the message handler makes
+	// libdatachannel deliver everything it has already buffered, on this
+	// thread, straight into OnDataChannelMessage -- which takes the global
+	// lock. Binding while still holding it deadlocks the caller against
+	// itself, which is what happened as soon as the accept side had a peer
+	// that was already sending.
+	if ( pTransport )
+		pTransport->BindDataChannelCallbacks();
+	return true;
+#else
+	(void)hConn; (void)pPeerConnection; (void)pDataChannel;
+	SpewError( "AcceptP2PWebRTCDataChannel: not compiled in this build (gamenetworkingsockets built without the webrtc-datachannel feature)" );
+	return false;
+#endif
+}
