+#ifdef STEAMNETWORKINGSOCKETS_ENABLE_WEBRTC_DATACHANNEL
+void CSteamNetworkConnectionP2P::AttachWebRTCDataChannelTransport(
+	std::shared_ptr<rtc::PeerConnection> pPeerConnection,
+	std::shared_ptr<rtc::DataChannel> pDataChannel
+)
+{
+	// Must be called before BInitConnect()/AcceptConnection() -- both check
+	// m_vecAvailableTransports for "do we have anything to try at all" and
+	// fail immediately if it's empty at that point (see BInitConnect and
+	// P2PInternalAcceptConnection). Unlike CheckInitICE()/BInitSDRTransport(),
+	// this isn't something GNS decides to call on its own -- see
+	// steamnetworkingsockets_p2p_webrtc_datachannel.h for why.
