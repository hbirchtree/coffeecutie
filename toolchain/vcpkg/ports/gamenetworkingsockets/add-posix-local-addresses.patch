 }
+#elif ( defined( __linux__ ) && !( defined( __ANDROID__ ) && __ANDROID_API__ < 24 ) ) || defined( __APPLE__ ) || defined( __FreeBSD__ ) || defined( __OpenBSD__ ) || defined( __NetBSD__ )
+
+// Added for coffeecutie -- upstream implements this for Windows only, and
+// the ICE client is dead in the water without it: GatherInterfaces() bails
+// the moment this returns false, so no host candidates are ever produced.
+bool GetLocalAddresses( CUtlVector< SteamNetworkingIPAddr >* pAddrs )
+{
+	if ( pAddrs == nullptr )
+		return false;
+
+	struct ifaddrs *pIfAddrs = nullptr;
+	if ( getifaddrs( &pIfAddrs ) != 0 )
+	{
+		SpewError( "getifaddrs failed - %s", strerror( errno ) );
+		return false;
+	}
+
+	for ( struct ifaddrs *pIfAddr = pIfAddrs; pIfAddr != nullptr; pIfAddr = pIfAddr->ifa_next )
+	{
+		if ( pIfAddr->ifa_addr == nullptr )
+			continue;
+
+		// An interface that is down has no usable address to gather a
+		// candidate from.  (GetAdaptersAddresses effectively does this for
+		// us in the Windows implementation above.)
+		if ( ( pIfAddr->ifa_flags & IFF_UP ) == 0 )
+			continue;
+
+		SteamNetworkingIPAddr ipAddr;
+		if ( pIfAddr->ifa_addr->sa_family == AF_INET )
+		{
+			sockaddr_in *pAddrIN = ( sockaddr_in * )( pIfAddr->ifa_addr );
+			ipAddr.SetIPv4( ntohl( pAddrIN->sin_addr.s_addr ), pAddrIN->sin_port );
+		}
+		else if ( pIfAddr->ifa_addr->sa_family == AF_INET6 )
+		{
+			sockaddr_in6 *pAddrIN6 = ( sockaddr_in6 * )( pIfAddr->ifa_addr );
+			ipAddr.SetIPv6( pAddrIN6->sin6_addr.s6_addr, pAddrIN6->sin6_port );
+		}
+		else
+		{
+			continue;
+		}
+
+		// Skip loopback addresses (127.0.0.1 and ::1), same as Windows.
+		if ( ipAddr.IsLocalHost() )
+			continue;
+
+		pAddrs->AddToTail( ipAddr );
+	}
+
+	freeifaddrs( pIfAddrs );
+	return true;
+}
 #else
 bool GetLocalAddresses( CUtlVector< SteamNetworkingIPAddr >* pAddrs )
 {
