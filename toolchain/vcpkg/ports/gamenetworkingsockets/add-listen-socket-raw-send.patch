+// Added for coffeecutie -- see the declaration comment in
+// isteamnetworkingsockets.h. Same lock/lookup shape as CloseListenSocket
+// above; AsSteamNetworkListenSocketDirectUDP() (steamnetworkingsockets_connections.h /
+// steamnetworkingsockets_udp.h) rejects listen sockets that aren't plain
+// direct-UDP (e.g. P2P), which have no single underlying UDP port to send from.
+bool CSteamNetworkingSockets::SendRawPacketOnListenSocket( HSteamListenSocket hSocket, const void *pPkt, int cbPkt, const SteamNetworkingIPAddr &adrTo )
+{
+	SteamNetworkingGlobalLock scopeLock( "SendRawPacketOnListenSocket" );
+	CSteamNetworkListenSocketBase *pSock = GetListenSocketByHandle( hSocket );
+	if ( !pSock )
+		return false;
+	CSteamNetworkListenSocketDirectUDP *pUDPSock = pSock->AsSteamNetworkListenSocketDirectUDP();
+	if ( !pUDPSock )
+		return false;
+	netadr_t netadrTo;
+	SteamNetworkingIPAddrToNetAdr( netadrTo, adrTo );
+	return pUDPSock->SendRawPacket( pPkt, cbPkt, netadrTo );
+}
