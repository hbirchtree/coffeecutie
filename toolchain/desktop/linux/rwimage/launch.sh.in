#!/bin/sh

# RWIMAGE_MOUNT is set by the runtime; fall back to dirname for manual invocation
if [ -n "$RWIMAGE_MOUNT" ]; then
    RWIMAGE_ROOT="$RWIMAGE_MOUNT"
else
    RWIMAGE_ROOT="$(dirname "$0")"
fi

# Find a Python interpreter for icon registration
if [ -n "$(which python3)" ]; then
    PYTHON_EXEC=python3
elif [ -n "$(which python2)" ]; then
    PYTHON_EXEC=python2
elif [ -n "$(which python)" ]; then
    PYTHON_EXEC=python
fi

# Register the app icon into the user's icon theme on first run
ICON_DIR="$HOME/.local/share/icons/hicolor/scalable/apps"
if [ ! -f "${ICON_DIR}/@RWI_TARGET@.svg" ]; then
    mkdir -p "$ICON_DIR"
    cp "${RWIMAGE_ROOT}/icon.svg" "${ICON_DIR}/@RWI_TARGET@.svg" 2>/dev/null || true
    if [ -n "${PYTHON_EXEC}" ]; then
        "${PYTHON_EXEC}" "${RWIMAGE_ROOT}/set_icon.py" "${RWIMAGE}" "${ICON_DIR}/@RWI_TARGET@.svg" 2>/dev/null || true
    fi
fi

# Writable store lives outside the read-only image
STORE_DIR="${HOME}/.local/share/@RWI_DOM_NAME@/store"
mkdir -p "$STORE_DIR"

export RWIMAGE_DATA_DIR="${RWIMAGE_ROOT}/assets"
export RWIMAGE_STORE_DIR="${STORE_DIR}"

export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:${RWIMAGE_ROOT}/lib"
export XDG_DATA_HOME="${HOME}/.local/share"
export XDG_DATA_DIRS="$XDG_DATA_DIRS:${RWIMAGE_ROOT}/share"

export COFFEE_NO_PROFILER_EXPORT="${COFFEE_NO_PROFILER_EXPORT:-1}"

CRASH="${RWIMAGE_ROOT}/bin/CrashRecovery"
if [ -f "$CRASH" ]; then
    exec "$CRASH" "${RWIMAGE_ROOT}/bin/@RWI_TARGET@" "${RWIMAGE_ROOT}/assets" "$@"
else
    exec "${RWIMAGE_ROOT}/bin/@RWI_TARGET@" "${RWIMAGE_ROOT}/assets" "$@"
fi
