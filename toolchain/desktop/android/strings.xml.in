<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">@ANDROID_APPLICATION_NAME@</string>
    <color name="activity_color">@ANDROID_APPLICATION_COLOR@</color>

    <color name="loading_background_color">#812041</color>
    <color name="loading_title_color">#ffffff</color>

    <color name="icon_background_primary">@ANDROID_APPLICATION_BACKGROUND_PRIMARY@</color>
    <color name="icon_background_secondary">@ANDROID_APPLICATION_BACKGROUND_SECONDARY@</color>

    <color name="icon_background_grid_color">@ANDROID_APPLICATION_BACKGROUND_GRID@</color>

    <color name="splash_background">#000</color>
</resources>
