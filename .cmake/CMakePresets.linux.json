{
    "version": 10,
    "include": [
        "CMakePresets.$penv{HOST_TOOLCHAIN_TRIPLET}.json"
    ],
    "configurePresets": [
        {
            "name": "vcpkg-base-linux",
            "inherits": ["vcpkg-base"],
            "hidden": true,
            "generator": "Ninja",
            "condition": {
                "lhs": "${hostSystemName}",
                "type": "equals",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "APPIMAGE_EXTRA_LIBRARIES": "$env{TOOLCHAIN_SYSROOT}/lib/libstdc++.so.6;$env{TOOLCHAIN_SYSROOT}/lib/libssp.so.0;$env{TOOLCHAIN_SYSROOT}/usr/lib/libbacktrace.so.0",
                "APPIMAGE_RUNTIME_BINARY": "${sourceDir}/multi_build/${presetName}/vcpkg_installed/$env{PLATFORM}-$env{TOOLCHAIN_PREFIX}/bin/runtime",
                "CMAKE_C_COMPILER": "$env{TOOLCHAIN_ROOT}/bin/$env{ARCHITECTURE}-gcc",
                "CMAKE_CXX_COMPILER": "$env{TOOLCHAIN_ROOT}/bin/$env{ARCHITECTURE}-g++",
                "CMAKE_MAKE_PROGRAM": "$env{NINJA}",
                "FLATPAK_EXTRA_LIBRARIES": "$env{TOOLCHAIN_SYSROOT}/lib/libstdc++.so.6;$env{TOOLCHAIN_SYSROOT}/lib/libssp.so.0;$env{TOOLCHAIN_SYSROOT}/usr/lib/libbacktrace.so.0;$env{TOOLCHAIN_SYSROOT}/usr/lib/libOSMesa.so.8",
                "RWIMAGE_EXTRA_LIBRARIES": "$env{TOOLCHAIN_SYSROOT}/lib/libstdc++.so.6;$env{TOOLCHAIN_SYSROOT}/usr/lib/libbacktrace.so.0",
                "MKSQUASH_PROGRAM": "$env{MKSQUASH_PROGRAM}",
                "TOOLCHAIN_PREFIX": "$env{TOOLCHAIN_PREFIX}",
                "TOOLCHAIN_ROOT": "$env{TOOLCHAIN_ROOT}",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/toolchain/cmake/Toolchains/$env{TOOLCHAIN_PREFIX}.toolchain.cmake",
                "VCPKG_TARGET_TRIPLET": "$env{PLATFORM}-$env{TOOLCHAIN_PREFIX}"
            },
            "environment": {
                "HOST_TOOLS_BINARY_DIR": "${sourceDir}/multi_build/host-x64-linux-native/bin",
                "HOST_TOOLS_DIR": "${sourceDir}/multi_build/host-x64-linux-native/vcpkg_installed/x64-linux-native/tools",
                "MKSQUASH_PROGRAM": "/usr/bin/mksquashfs",
                "NINJA": "$penv{NINJA}",
                "PATH": "$penv{PATH}:$env{TOOLCHAIN_ROOT}/bin",
                "TOOLCHAIN_PREFIX": "$env{ARCHITECTURE}",
                "TOOLCHAIN_ROOT": "${sourceDir}/multi_build/compilers/$env{PLATFORM}-$env{ARCHITECTURE}/$env{TOOLCHAIN_VERSION}",
                "TOOLCHAIN_SYSROOT": "$env{TOOLCHAIN_ROOT}/$env{TOOLCHAIN_PREFIX}/sysroot",
                "TOOLCHAIN_VERSION": "v2.2",
                "VCPKG_INSTALL_DIR": "${sourceDir}/multi_build/${presetName}/vcpkg_installed/$env{PLATFORM}-$env{ARCHITECTURE}"
            }
        },
        {
            "name": "vcpkg-base-linux-es20",
            "inherits": ["vcpkg-base-linux"],
            "hidden": true,
            "cacheVariables": {
                "BUILD_EGL": "ON",
                "BUILD_EGL_DOUBLE_GETPROC": "ON",
                "BUILD_GL_SOFTWARE_BCN": "ON",
                "BUILD_GLES": "ON",
                "BUILD_GLES_20": "ON",
                "BUILD_MEDIA": "OFF"
            },
            "environment": {
                "ARCHITECTURE": "arm-buildroot-linux-gnueabihf"
            }
        },
        {
            "name": "vcpkg-base-linux-egl-es20",
            "inherits": ["vcpkg-base-linux-es20"],
            "hidden": true,
            "cacheVariables": {
                "BUILD_EGL": "ON",
                "BUILD_EGL_DOUBLE_GETPROC": "ON",
                "BUILD_SDL2": "OFF"
            }
        },
        {
            "name": "native-linux",
            "displayName": "Native Linux build",
            "inherits": ["vcpkg-base"],
            "generator": "Ninja",
            "condition": {
                "lhs": "${hostSystemName}",
                "type": "equals",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_FLAGS": "-march=native",
                "CMAKE_CXX_FLAGS": "-march=native",
                "CMAKE_MAKE_PROGRAM": "$env{NINJA}",
                "MKSQUASH_PROGRAM": "$env{MKSQUASH_PROGRAM}",
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/toolchain/vcpkg/ports/sdl2"
            },
            "environment": {
                "MKSQUASH_PROGRAM": "/usr/bin/mksquash",
                "NINJA": "$penv{NINJA}"
            }
        },
        {
            "name": "beaglebone-arm-buildroot-linux-gnueabihf-ti-sgx",
            "displayName": "Beaglebone ARMv7 TI-SGX OpenGL ES 2.0 (NullWS)",
            "inherits": ["vcpkg-base-linux-egl-es20"],
            "cacheVariables": {
                "BUILD_GLSCREENSHOT": "ON",
                "BUILD_IMGUI": "OFF",
                "BUILD_OPENAL": "OFF",
                "BUILD_PVRSCOPE": "ON",
                "VCPKG_DEP_INFO_OVERRIDE_VARS": "beaglebone;sgx;arm;arm32;linux"
            },
            "environment": {
                "PLATFORM": "beaglebone"
            }
        },
        {
            "name": "desktop-x86_64-buildroot-linux-gnu-multi",
            "displayName": "Linux x86_64v3 AVX2 Core OpenGL (SDL2)",
            "inherits": ["vcpkg-base-linux"],
            "cacheVariables": {
                "BUILD_DISCORD_RPC": "ON",
                "BUILD_EGL": "ON",
                "BUILD_GLSCREENSHOT": "ON",
                "BUILD_GL_SOFTWARE_BCN": "ON",
                "BUILD_GL_SOFTWARE_PVRTC": "ON",
                "BUILD_OSMESA": "OFF",
                "GENERATE_APPDIR": "ON",
                "GENERATE_FLATPAK": "ON",
                "GENERATE_RWIMAGE": "ON",
                "VCPKG_DEP_INFO_OVERRIDE_VARS": "desktop;linux;wayland;x11;x64;x86_64",
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/toolchain/vcpkg/ports/sdl2",
                "VCPKG_TARGET_TRIPLET": "desktop-x86-64-buildroot-linux-gnu"
            },
            "environment": {
                "ARCHITECTURE": "x86_64-buildroot-linux-gnu",
                "PLATFORM": "desktop",
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/toolchain/vcpkg/ports/sdl2"
            }
        },
        {
            "name": "desktop-x64-linux-multi",
            "displayName": "Linux x86_64 AVX2 Core OpenGL (SDL2) (System libs)",
            "inherits": ["vcpkg-base"],
            "generator": "Ninja",
            "condition": {
                "lhs": "${hostSystemName}",
                "type": "equals",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "BUILD_DISCORD_RPC": "ON",
                "BUILD_GLSCREENSHOT": "ON",
                "BUILD_GL_SOFTWARE_PVRTC": "ON",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_FLAGS": "-march=native",
                "CMAKE_CXX_FLAGS": "-march=native",
                "CMAKE_MAKE_PROGRAM": "$env{NINJA}",
                "VCPKG_DEP_INFO_OVERRIDE_VARS": "desktop;linux;wayland;x11;x64;x86_64",
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/toolchain/vcpkg/ports/sdl2"
            },
            "environment": {
                "HOST_TOOLS_BINARY_DIR": "${sourceDir}/multi_build/host-x64-linux-native/bin",
                "HOST_TOOLS_DIR": "${sourceDir}/multi_build/host-x64-linux-native/vcpkg_installed/x64-linux-native/tools",
                "MKSQUASH_PROGRAM": "/usr/bin/mksquashfs",
                "NINJA": "$penv{NINJA}",
                "TOOLCHAIN_REQUIRED": "1",
                "PATH": "$penv{PATH}:$env{TOOLCHAIN_ROOT}/bin",
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/toolchain/vcpkg/ports/sdl2",
                "VCPKG_INSTALL_DIR": "${sourceDir}/multi_build/${presetName}/vcpkg_installed/$env{PLATFORM}-$env{ARCHITECTURE}"

            }
        },
        {
            "name": "desktop-x86_64v2-buildroot-linux-gnu-multi",
            "displayName": "Linux x86_64v2 SSE4.2 Core OpenGL (SDL2)",
            "inherits": ["vcpkg-base-linux"],
            "cacheVariables": {
                "BUILD_DISCORD_RPC": "ON",
                "BUILD_GLSCREENSHOT": "ON",
                "BUILD_GL_SOFTWARE_BCN": "ON",
                "BUILD_GL_SOFTWARE_PVRTC": "ON",
                "GENERATE_APPDIR": "ON",
                "GENERATE_FLATPAK": "ON",
                "GENERATE_RWIMAGE": "ON",
                "VCPKG_DEP_INFO_OVERRIDE_VARS": "desktop;linux;wayland;x11;x64;x86_64",
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/toolchain/vcpkg/ports/sdl2",
                "VCPKG_TARGET_TRIPLET": "desktop-x86-64v2-buildroot-linux-gnu"
            },
            "environment": {
                "ARCHITECTURE": "x86_64-buildroot-linux-gnu",
                "PLATFORM": "desktop",
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/toolchain/vcpkg/ports/sdl2"
            }
        },
        {
            "name": "desktop-aarch64-buildroot-linux-gnu-multi",
            "displayName": "Linux ARMv8.1 OpenGL ES 3.x (SDL2)",
            "inherits": ["vcpkg-base-linux"],
            "cacheVariables": {
                "BUILD_GLSCREENSHOT": "ON",
                "BUILD_GL_SOFTWARE_BCN": "ON",
                "BUILD_GLES": "ON",
                "BUILD_GLES_31": "ON",
                "BUILD_IMGUI": "OFF",
                "BUILD_OPENAL": "OFF",
                "CMAKE_C_FLAGS": "-march=armv8.1-a",
                "CMAKE_CXX_FLAGS": "-march=armv8.1-a",
                "CMAKE_LINKER_FLAGS": "-fuse-ld=gold",
                "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=gold",
                "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=gold",
                "GENERATE_APPDIR": "ON",
                "GENERATE_FLATPAK": "ON",
                "GENERATE_RWIMAGE": "ON",
                "VCPKG_DEP_INFO_OVERRIDE_VARS": "desktop;linux;wayland;x11;arm64;aarch64"
            },
            "environment": {
                "ARCHITECTURE": "aarch64-buildroot-linux-gnu",
                "PLATFORM": "desktop"
            }
        },
        {
            "name": "desktop-arm-buildroot-linux-gnueabihf-sdl2",
            "displayName": "Linux ARMv7 OpenGL ES 2.0 (SDL2)",
            "inherits": ["vcpkg-base-linux-es20"],
            "cacheVariables": {
                "BUILD_EGL": "OFF",
                "BUILD_GL_SOFTWARE_BCN": "ON",
                "BUILD_IMGUI": "OFF",
                "BUILD_OPENAL": "OFF",
                "CMAKE_C_FLAGS": "-march=armv7-a+simd+vfpv4",
                "CMAKE_CXX_FLAGS": "-march=armv7-a+simd+vfpv4",
                "CMAKE_LINKER_FLAGS": "-fuse-ld=gold",
                "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=gold",
                "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=gold",
                "GENERATE_FLATPAK": "ON",
                "VCPKG_DEP_INFO_OVERRIDE_VARS": "arm;arm32;linux;wayland;x11"
            },
            "environment": {
                "ARCHITECTURE": "arm-buildroot-linux-gnueabihf",
                "PLATFORM": "desktop"
            }
        },
        {
            "name": "raspberry-armv6-buildroot-linux-gnueabihf-vc",
            "displayName": "Raspberry Pi ARMv7 OpenGL ES 2.0 (DispManX)",
            "inherits": ["vcpkg-base-linux-egl-es20"],
            "cacheVariables": {
                "BUILD_DISPMANX": "ON",
                "BUILD_EGL_STATIC": "ON",
                "VCPKG_DEP_INFO_OVERRIDE_VARS": "arm;arm32;linux;raspberry;videocore"
            },
            "environment": {
                "ARCHITECTURE": "armv6-buildroot-linux-gnueabihf",
                "PLATFORM": "raspberry"
            }
        },
        {
            "name": "host-x64-linux-native",
            "displayName": "Host tools for Linux x86_64",
            "inherits": ["host-tools"],
            "generator": "Ninja",
            "condition": {
                "lhs": "${hostSystemName}",
                "type": "equals",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_MAKE_PROGRAM": "$env{NINJA}",
                "VCPKG_TARGET_TRIPLET": "x64-linux-native"
            },
            "environment": {
                "NINJA": "$penv{NINJA}"
            }
        },
        {
            "name": "host-arm64-linux-native",
            "displayName": "Host tools for Linux AArch64",
            "inherits": ["host-tools"],
            "generator": "Ninja",
            "condition": {
                "lhs": "${hostSystemName}",
                "type": "equals",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_MAKE_PROGRAM": "$env{NINJA}"
            },
            "environment": {
                "NINJA": "$penv{NINJA}"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "beaglebone-arm-buildroot-linux-gnueabihf-ti-sgx-rel",
            "environment": {"BUILD_TYPE":"Release"},
            "configurePreset": "beaglebone-arm-buildroot-linux-gnueabihf-ti-sgx",
            "inherits": "base-linux"
        },
        {
            "name": "beaglebone-arm-buildroot-linux-gnueabihf-ti-sgx-reldeb",
            "environment": {"BUILD_TYPE":"RelWithDebInfo"},
            "configurePreset": "beaglebone-arm-buildroot-linux-gnueabihf-ti-sgx",
            "inherits": "base-linux"
        },
        {
            "name": "beaglebone-arm-buildroot-linux-gnueabihf-ti-sgx-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "beaglebone-arm-buildroot-linux-gnueabihf-ti-sgx",
            "inherits": "base-linux"
        },
        {
            "name": "desktop-aarch64-buildroot-linux-gnu-multi-rel",
            "environment": {"BUILD_TYPE":"Release"},
            "configurePreset": "desktop-aarch64-buildroot-linux-gnu-multi",
            "inherits": "base-linux"
        },
        {
            "name": "desktop-aarch64-buildroot-linux-gnu-multi-reldeb",
            "environment": {"BUILD_TYPE":"RelWithDebInfo"},
            "configurePreset": "desktop-aarch64-buildroot-linux-gnu-multi",
            "inherits": "base-linux"
        },
        {
            "name": "desktop-aarch64-buildroot-linux-gnu-multi-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "desktop-aarch64-buildroot-linux-gnu-multi",
            "inherits": "base-linux"
        },
        {
            "name": "desktop-x86_64-buildroot-linux-gnu-multi-rel",
            "environment": {"BUILD_TYPE":"Release"},
            "configurePreset": "desktop-x86_64-buildroot-linux-gnu-multi",
            "inherits": "base-linux"
        },
        {
            "name": "desktop-x86_64-buildroot-linux-gnu-multi-reldeb",
            "environment": {"BUILD_TYPE":"RelWithDebInfo"},
            "configurePreset": "desktop-x86_64-buildroot-linux-gnu-multi",
            "inherits": "base-linux"
        },
        {
            "name": "desktop-x86_64-buildroot-linux-gnu-multi-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "desktop-x86_64-buildroot-linux-gnu-multi",
            "inherits": "base-linux"
        },
        {
            "name": "desktop-x64-linux-multi-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "desktop-x64-linux-multi",
            "inherits": "base-linux"
        },
        {
            "name": "desktop-x86_64v2-buildroot-linux-gnu-multi-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "desktop-x86_64v2-buildroot-linux-gnu-multi",
            "inherits": "base-linux"
        },
        {
            "name": "desktop-arm-buildroot-linux-gnueabihf-sdl2-rel",
            "environment": {"BUILD_TYPE":"Release"},
            "configurePreset": "desktop-arm-buildroot-linux-gnueabihf-sdl2",
            "inherits": "base-linux"
        },
        {
            "name": "desktop-arm-buildroot-linux-gnueabihf-sdl2-reldeb",
            "environment": {"BUILD_TYPE":"RelWithDebInfo"},
            "configurePreset": "desktop-arm-buildroot-linux-gnueabihf-sdl2",
            "inherits": "base-linux"
        },
        {
            "name": "desktop-arm-buildroot-linux-gnueabihf-sdl2-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "desktop-arm-buildroot-linux-gnueabihf-sdl2",
            "inherits": "base-linux"
        },
        {
            "name": "host-x64-linux-native-rel",
            "environment": {"BUILD_TYPE":"Release"},
            "configurePreset": "host-x64-linux-native",
            "inherits": "base-linux"
        },
        {
            "name": "host-x64-linux-native-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "host-x64-linux-native",
            "inherits": "base-linux"
        },
        {
            "name": "host-arm64-linux-native-rel",
            "environment": {"BUILD_TYPE":"Release"},
            "configurePreset": "host-arm64-linux-native",
            "inherits": "base-linux"
        },
        {
            "name": "host-arm64-linux-native-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "host-arm64-linux-native",
            "inherits": "base-linux"
        },
        {
            "name": "native-linux-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "native-linux",
            "inherits": "base-linux"
        },
        {
            "name": "raspberry-armv6-buildroot-linux-gnueabihf-vc-rel",
            "environment": {"BUILD_TYPE":"Release"},
            "configurePreset": "raspberry-armv6-buildroot-linux-gnueabihf-vc",
            "inherits": "base-linux"
        },
        {
            "name": "raspberry-armv6-buildroot-linux-gnueabihf-vc-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "raspberry-armv6-buildroot-linux-gnueabihf-vc",
            "inherits": "base-linux"
        }
    ]
}
