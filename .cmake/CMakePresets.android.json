{
    "version": 10,
    "include": [
        "CMakePresets.$penv{HOST_TOOLCHAIN_TRIPLET}.json"
    ],
    "configurePresets": [
        {
            "name": "vcpkg-base-android",
            "inherits": ["vcpkg-base"],
            "hidden": true,
            "generator": "Ninja",
            "condition": {
                "lhs": "${hostSystemName}",
                "type": "equals",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "ANDROID_NDK": "$env{ANDROID_NDK}",
                "ANDROID_NDK_HOME": "$env{ANDROID_NDK}",
                "ANDROID_SDK": "$env{ANDROID_SDK}",
                "ANDROID_PLATFORM": "android-$env{API}",
                "BUILD_ANATIVE": "ON",
                "BUILD_EGL": "ON",
                "BUILD_GLES": "ON",
                "BUILD_GLES_31": "ON",
                "BUILD_GLES_32": "ON",
                "BUILD_GL_SOFTWARE_BCN": "ON",
                "BUILD_MEDIA": "OFF",
                "BUILD_SDL2": "OFF",
                "CMAKE_MAKE_PROGRAM": "$env{NINJA}",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/toolchain/vcpkg/toolchains/android.cmake",
                "VCPKG_CMAKE_SYSTEM_VERSION": "$env{API}",
                "VCPKG_CRT_LINKAGE": "static",
                "VCPKG_DEP_INFO_OVERRIDE_VARS": "android;arm;arm64",
                "VCPKG_LIBRARY_LINKAGE": "static",
                "VCPKG_TARGET_TRIPLET": "$env{ARCHITECTURE}-android-$env{API}"
            },
            "environment": {
                "ANDROID_NDK": "$env{ANDROID_SDK}/ndk/$env{NDK_VERSION}",
                "ANDROID_NDK_HOME": "$env{ANDROID_SDK}/ndk/$env{NDK_VERSION}",
                "ANDROID_SDK": "${sourceDir}/multi_build/compilers/android/latest",
                "API": "35",
                "ARCHITECTURE": "arm64",
                "NDK_VERSION": "29.0.14206865",
                "NINJA": "$penv{NINJA}"
            }
        },
        {
            "name": "android-arm64-35",
            "displayName": "Android 15 ARM64",
            "inherits": ["vcpkg-base-android"],
            "cacheVariables": {
                "ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES": "ON",
                "CMAKE_C_FLAGS": "-march=armv8-a",
                "CMAKE_CXX_FLAGS": "-march=armv8-a"
            }
        },
        {
            "name": "android-arm64-32",
            "displayName": "Android 12 ARM64",
            "inherits": ["vcpkg-base-android"],
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=armv8-a",
                "CMAKE_CXX_FLAGS": "-march=armv8-a"
            },
            "environment": {
                "API": "32"
            }
        },
        {
            "name": "android-x64-32",
            "displayName": "Android 12 x86_64",
            "inherits": ["vcpkg-base-android"],
            "cacheVariables": {
                "VCPKG_DEP_INFO_OVERRIDE_VARS": "android;x64"
            },
            "environment": {
                "API": "32",
                "ARCHITECTURE": "x64"
            }
        },
        {
            "name": "android-arm64-30-gl",
            "displayName": "Android 11 ARM64 Core OpenGL",
            "inherits": ["vcpkg-base-android"],
            "cacheVariables": {
                "BUILD_GLES": "OFF",
                "BUILD_GLAD_GETPROC": "ON",
                "BUILD_GL_SOFTWARE_BCN": "OFF",
                "CMAKE_C_FLAGS": "-mcpu=cortex-a57",
                "CMAKE_CXX_FLAGS": "-mcpu=cortex-a57"
            },
            "environment": {
                "API": "30"
            }
        },
        {
            "name": "android-arm64-30",
            "displayName": "Android 11 ARM64",
            "inherits": ["vcpkg-base-android"],
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=armv8-a",
                "CMAKE_CXX_FLAGS": "-march=armv8-a"
            },
            "environment": {
                "API": "30"
            }
        },
        {
            "name": "android-arm64-25",
            "displayName": "Android 7 ARM64",
            "inherits": ["vcpkg-base-android"],
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=armv8-a",
                "CMAKE_CXX_FLAGS": "-march=armv8-a"
            },
            "environment": {
                "API": "25"
            }
        },
        {
            "name": "android-arm-neon-19",
            "displayName": "Android 4.4 ARMv7+NEON",
            "inherits": ["vcpkg-base-android"],
            "cacheVariables": {
                "ANDROID_ARM_NEON": "ON",
                "BUILD_COMP_DUMMY_PLUG": "OFF",
                "BUILD_GLES_31": "OFF",
                "BUILD_GLES_32": "OFF",
                "CMAKE_C_FLAGS": "-march=armv7-a",
                "CMAKE_CXX_FLAGS": "-march=armv7-a",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/toolchain/vcpkg/toolchains/android-kitkat.cmake",
                "VCPKG_DEP_INFO_OVERRIDE_VARS": "android;arm;arm32;arm_neon",
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/toolchain/vcpkg/ports-android-kitkat"
            },
            "environment": {
                "API": "19",
                "ARCHITECTURE": "arm-neon",
                "NDK_VERSION": "25.2.9519653"
            }
        },
        {
            "name": "android-arm-neon-21",
            "displayName": "Android 5 ARMv7+NEON",
            "inherits": ["vcpkg-base-android"],
            "cacheVariables": {
                "ANDROID_ARM_NEON": "ON",
                "BUILD_GLES_32": "OFF",
                "CMAKE_C_FLAGS": "-march=armv7-a",
                "CMAKE_CXX_FLAGS": "-march=armv7-a",
                "VCPKG_DEP_INFO_OVERRIDE_VARS": "android;arm;arm32;arm_neon"
            },
            "environment": {
                "API": "21",
                "ARCHITECTURE": "arm-neon"
            }
        },
        {
            "name": "android-arm-neon-24",
            "displayName": "Android 7 ARMv7+NEON",
            "inherits": ["vcpkg-base-android"],
            "cacheVariables": {
                "ANDROID_ARM_NEON": "ON",
                "CMAKE_C_FLAGS": "-march=armv7-a",
                "CMAKE_CXX_FLAGS": "-march=armv7-a",
                "VCPKG_DEP_INFO_OVERRIDE_VARS": "android;arm;arm32;arm_neon"
            },
            "environment": {
                "API": "24",
                "ARCHITECTURE": "arm-neon"
            }
        },
        {
            "name": "android-arm-neon-29",
            "displayName": "Android 10 ARMv7+NEON",
            "inherits": ["vcpkg-base-android"],
            "cacheVariables": {
                "ANDROID_ARM_NEON": "ON",
                "CMAKE_C_FLAGS": "-march=armv7-a",
                "CMAKE_CXX_FLAGS": "-march=armv7-a",
                "VCPKG_DEP_INFO_OVERRIDE_VARS": "android;arm;arm32;arm_neon"
            },
            "environment": {
                "API": "29",
                "ARCHITECTURE": "arm-neon"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "android-arm-neon-19-rel",
            "environment": {"BUILD_TYPE":"Release"},
            "configurePreset": "android-arm-neon-19",
            "inherits": "base-linux"
        },
        {
            "name": "android-arm-neon-19-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "android-arm-neon-19",
            "inherits": "base-linux"
        },
        {
            "name": "android-arm-neon-21-rel",
            "environment": {"BUILD_TYPE":"Release"},
            "configurePreset": "android-arm-neon-21",
            "inherits": "base-linux"
        },
        {
            "name": "android-arm-neon-21-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "android-arm-neon-21",
            "inherits": "base-linux"
        },
        {
            "name": "android-arm-neon-24-rel",
            "environment": {"BUILD_TYPE":"Release"},
            "configurePreset": "android-arm-neon-24",
            "inherits": "base-linux"
        },
        {
            "name": "android-arm-neon-24-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "android-arm-neon-24",
            "inherits": "base-linux"
        },
        {
            "name": "android-arm64-25-rel",
            "environment": {"BUILD_TYPE":"Release"},
            "configurePreset": "android-arm64-25",
            "inherits": "base-linux"
        },
        {
            "name": "android-arm64-25-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "android-arm64-25",
            "inherits": "base-linux"
        },
        {
            "name": "android-arm-neon-29-rel",
            "environment": {"BUILD_TYPE":"Release"},
            "configurePreset": "android-arm-neon-29",
            "inherits": "base-linux"
        },
        {
            "name": "android-arm-neon-29-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "android-arm-neon-29",
            "inherits": "base-linux"
        },
        {
            "name": "android-arm64-30-rel",
            "environment": {"BUILD_TYPE":"Release"},
            "configurePreset": "android-arm64-30",
            "inherits": "base-linux"
        },
        {
            "name": "android-arm64-30-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "android-arm64-30",
            "inherits": "base-linux"
        },
        {
            "name": "android-arm64-30-gl-rel",
            "environment": {"BUILD_TYPE":"Release"},
            "configurePreset": "android-arm64-30-gl",
            "inherits": "base-linux"
        },
        {
            "name": "android-arm64-30-gl-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "android-arm64-30-gl",
            "inherits": "base-linux"
        },
        {
            "name": "android-arm64-35-rel",
            "environment": {"BUILD_TYPE":"Release"},
            "configurePreset": "android-arm64-35",
            "inherits": "base-linux"
        },
        {
            "name": "android-arm64-35-reldeb",
            "environment": {"BUILD_TYPE":"RelWithDebInfo"},
            "configurePreset": "android-arm64-35",
            "inherits": "base-linux"
        },
        {
            "name": "android-arm64-35-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "android-arm64-35",
            "inherits": "base-linux"
        },
        {
            "name": "android-arm64-32-rel",
            "environment": {"BUILD_TYPE":"Release"},
            "configurePreset": "android-arm64-32",
            "inherits": "base-linux"
        },
        {
            "name": "android-arm64-32-reldeb",
            "environment": {"BUILD_TYPE":"RelWithDebInfo"},
            "configurePreset": "android-arm64-32",
            "inherits": "base-linux"
        },
        {
            "name": "android-arm64-32-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "android-arm64-32",
            "inherits": "base-linux"
        },
        {
            "name": "android-x64-32-dbg",
            "environment": {"BUILD_TYPE":"Debug"},
            "configurePreset": "android-x64-32",
            "inherits": "base-linux"
        }
    ]
}
